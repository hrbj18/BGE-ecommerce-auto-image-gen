IMAGE_PROVIDER=aiecho
IMAGE_COMPOSITION_MODE=native
AIECHO_BASE_URL=https://api.jujuai.com.cn
AIECHO_ACTIVATION_CODE=
AIECHO_RESOLUTION=2k
IMAGE_TUNNEL_PROVIDER=litterbox

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_BRIEF_TIMEOUT_MS=180000
OPENAI_IMAGE_CONCURRENCY=5
OPENAI_IMAGE_COOLDOWN_MS=0
OPENAI_IMAGE_MAX_RETRIES=1
OPENAI_IMAGE_429_RETRY_AFTER_MS=15000
OPENAI_IMAGE_TIMEOUT_MS=300000
IMAGE_OUTPUT_VISION_AUDIT=true
IMAGE_OUTPUT_VISION_AUDIT_TIMEOUT_MS=120000
IMAGE_OUTPUT_VISION_AUDIT_RETRY=true
IMAGE_OUTPUT_VISION_AUDIT_STRICT=false
OPENAI_IMAGE_JOB_MAX_ATTEMPTS=4
OPENAI_IMAGE_CONCURRENCY_LADDER=5,3,2,1
OPENAI_IMAGE_BACKPRESSURE_DELAY_MS=15000
OPENAI_IMAGE_TRANSIENT_RETRY_DELAY_MS=5000
IMAGE_RECOVERY_CONCURRENCY=2
IMAGE_OUTPUT_VISION_AUDIT_RETRY_CONCURRENCY=2
IMAGE_JOB_TOTAL_TIMEOUT_MS=3600000

WORKSPACE_DIR=.
DROP_INPUT_DIR=待作图
DROP_OUTPUT_DIR=已完成
SKIP_REFERENCE_SEARCH=true
MAX_REFERENCES=5
CONCURRENCY=1
FORCE_REGENERATE=false
LOCAL_IMAGE_TEST_MODE=false

# Internal testing defaults to direct LAN access. Change mode to token and set a
# private token in .env when access control needs to be enabled again.
LOCAL_WEB_ACCESS_MODE=off
LOCAL_WEB_ACCESS_TOKEN=
LOCAL_WEB_ALLOWED_ORIGINS=
LOCAL_WEB_MAX_REQUEST_MB=64
LOCAL_WEB_MAX_FILE_MB=20
LOCAL_WEB_MAX_TEMPLATE_MB=1
LOCAL_WEB_MAX_BRIEF_CHARS=20000
LOCAL_WEB_MAX_REFERENCE_IMAGES=5
LOCAL_WEB_MAX_IMAGE_PIXELS=50000000
LOCAL_WEB_MAX_IMAGE_DIMENSION=16384
LOCAL_WEB_MIN_FREE_GB=5
LOCAL_WEB_WORKFLOW_TIMEOUT_MS=8100000
AUTOMATION_LOCK_HEARTBEAT_MS=15000
AUTOMATION_LOCK_HEARTBEAT_STALE_MS=90000

DATA_DIR=data
OUTPUT_DIR=output
TASK_WORKBOOK=templates/本地自动化作图任务模板.xlsx
